# Application
APP_NAME=TRUSTLAYER Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Use SQLite for local development. Change to PostgreSQL for shared deployment.
# Example: postgresql+asyncpg://trustlayer:password@localhost:5432/trustlayer
DATABASE_URL=sqlite+aiosqlite:///./trustlayer.db

# DetectifAI - create a scoped key in the DetectifAI dashboard.
DETECTIF_API_KEY=
DETECTIF_BASE_URL=https://platform.detectif.ai
DETECTIF_TIMEOUT_SECONDS=300

# Webhook signing secret shown once when registering the endpoint in DetectifAI.
DETECTIF_WEBHOOK_SECRET=
WEBHOOK_TOLERANCE_SECONDS=300

# Browser origins allowed to call this backend.
# To allow the TRUSTLAYER Guardian Chrome extension to call this backend,
# add your extension origin:  chrome-extension://<YOUR_EXTENSION_ID>
# Find your extension ID at chrome://extensions after loading the unpacked extension.
# Example (replace the ID):
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limit for this application (provider limit may be higher).
MAX_UPLOAD_MB=25

# Optional shared development token. Set this before exposing the backend through a tunnel.
# When configured, send Authorization: Bearer <token> to protected REST routes.
BACKEND_ACCESS_TOKEN=


# Optional Gemini and Sarvam intelligence providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_OUTPUT_TOKENS=1024
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_MODEL=saaras:v2.5
SARVAM_TIMEOUT_SECONDS=60
SARVAM_SAMPLE_RATE=16000
SARVAM_ENCODING=audio/pcm
